# SKORIVA — contoh environment (development)
# Salin ke .env lalu isi nilainya. Jangan commit .env.
# Daftar variabel mengikuti Tech Spec §5.4.

# MongoDB 7 (lokal atau Atlas) — wajib untuk T-06+
MONGODB_URI=

# Secret JWT akun opsional
# Wajib, minimal 32 karakter. Jangan gunakan nilai default/lemah.
JWT_SECRET=

# Pepper untuk hash token operator / viewCode
# Wajib, minimal 32 karakter. Jangan gunakan nilai default/lemah.
TOKEN_PEPPER=

# Origin frontend (CORS)
WEB_ORIGIN=http://localhost:3000

# Port backend (opsional; default 4000)
PORT=4000

# Endpoint backend untuk browser (dibaca Next.js di build/runtime)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
