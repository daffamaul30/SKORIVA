{
  "name": "skoriva",
  "version": "0.0.0",
  "private": true,
  "description": "SKORIVA — multi-sport scoreboard platform (monorepo)",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "turbo": "2.11.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
