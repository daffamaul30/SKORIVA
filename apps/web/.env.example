# SKORIVA — contoh environment untuk aplikasi web (Next.js)
#
# Salin file ini menjadi `apps/web/.env.local` (development) atau isi variabel
# yang sama di dashboard hosting. Jangan commit file env yang berisi nilai asli.
#
# Next.js menjalankan proses dari `apps/web`, sehingga hanya membaca file env di
# direktori ini — bukan `.env` di root monorepo. File ini sengaja hanya berisi
# variabel frontend. Secret backend tetap tinggal di `.env` root untuk `apps/api`
# dan tidak boleh disalin ke sini.

# Origin backend untuk proxy same-origin `/api/*` (T-31.1).
# Server-only: tidak boleh memakai awalan NEXT_PUBLIC_. Dipakai oleh
# `next.config.ts` saat start/build, bukan oleh kode browser.
# Tanpa nilai yang valid, `next.config.ts` gagal saat start (lihat src/lib/env.ts).
BACKEND_URL=http://localhost:4000

# Origin Socket.IO yang dibaca browser (dipakai pada subtask T-31.5).
# Ini satu-satunya variabel NEXT_PUBLIC_ di aplikasi web dan tidak memuat
# credential apa pun; autentikasi socket memakai token/viewCode di `match:join`.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
